{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/deny-git.js\"",
            "timeout": 10,
            "statusMessage": "Checking AGENTS.md section 7"
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-paths.js\"",
            "timeout": 10,
            "statusMessage": "Checking AGENTS.md rules 5 and 6"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-emdash.js\"",
            "timeout": 10,
            "statusMessage": "Checking AGENTS.md section 6"
          }
        ]
      }
    ]
  }
}
