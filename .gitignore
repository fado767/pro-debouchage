# Cloud backup covers ONLY the root paths whitelisted below, nothing else.
# Everything is whitelisted on purpose except machine-local and generated files.
# Keep this list in step with AGENTS.md section 3 (the folder map).
/*
!/.gitignore
!/save-to-cloud.cmd
!/first-time-setup.cmd
!/.claude/
/.claude/*
!/.claude/skills/
!/.claude/hooks/
!/.claude/scripts/
!/.claude/settings.json
!/AGENTS.md
!/CLAUDE.md
!/STATE.md
!/NOW.md
!/DECISIONS.md
!/LOG.md
!/HANDOFF.md
!/playbook/
!/research/
!/assets/
!/site-v1/
!/design/
!/_archive/

# generated per-session scratch state of the logging guard (added 2026-09-04, shared kit), never history
/.claude/hooks/state/

# never track these, anywhere
node_modules/
.wrangler/
*.bak
*.bak-*
Thumbs.db
.DS_Store
